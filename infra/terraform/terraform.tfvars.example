# Copie para terraform.tfvars e preencha. NÃO versione o terraform.tfvars.
#
#   cp terraform.tfvars.example terraform.tfvars
#   chmod 600 terraform.tfvars

# --- Proxy -----------------------------------------------------------------
# Numa VPS dedicada e limpa, deixe true: o Traefik desta stack sobe em 80 e 443
# e cuida do TLS sozinho. Confira antes que as portas estão livres:
#   ss -tlnp '( sport = :80 or sport = :443 )'
usar_traefik = true

# Só importam com usar_traefik = false, quando a máquina já tem proxy nessas
# portas (Easypanel, nginx, outro Traefik). Aí a API entra na rede dele e
# também é publicada em 127.0.0.1:porta_host_api.
#   docker network ls   para descobrir o nome da rede
# rede_proxy_externa = "easypanel"
# porta_host_api     = 8080

# --- Domínio e TLS ---------------------------------------------------------
# Antes do apply: registro A de api.exemplo.com.br apontando para o IP da VPS,
# já propagado. Confira com: dig +short api.exemplo.com.br
# Provisório: o DNS do strenos.com.br é seu e o registro sai na hora.
# O definitivo é api.clinicaears.com.br, que depende de quem administra
# aquela zona. Trocar depois é mudar esta linha e dar apply.
dominio = "ears.strenos.com.br"

# Os dois abaixo só valem com usar_traefik = true. Com proxy externo, quem
# emite e renova certificado é ele.
acme_email   = "eric@strenos.com.br"
acme_staging = true

# --- Aplicação -------------------------------------------------------------
# Caminho do repositório na VPS; o Terraform constrói a imagem daqui.
app_contexto = "/opt/ears/src"
app_versao   = "1.0.0"

# Alternativa: imagem pronta de um registry, e app_contexto deixa de importar.
# app_image = "ghcr.io/strenos/ears-integration:1.0.0"

# --- Segredos --------------------------------------------------------------
admin_api_key = "troque-por-algo-longo-e-aleatorio"

# Faixas que podem alcançar /admin. Vazio deixa o endpoint aberto na internet,
# protegido só pela chave acima.
admin_ips = [
  # "203.0.113.4/32",
]

# Homologação: https://stgintegracoes.amplimed.cloud/
amplimed_base_url                  = "https://integracoes.amplimed.com.br/"
amplimed_pacientes_token           = ""
amplimed_agendamento_identificador = ""
amplimed_agendamento_token         = ""

# Número da clínica. Vazio derruba para o cenário B da Cláusula 3ª.
amplimed_usuclin = ""

# Raiz da API. Só mexa se a SleekFlow indicar outro ambiente que fale o mesmo
# dialeto desta integração. api.onsleek.ai é outro produto e não funciona aqui.
# sleekflow_base_url = "https://api.sleekflow.io/"

sleekflow_api_key        = ""
sleekflow_webhook_secret = ""

# Número remetente da clínica, com DDI e sem o "+". Obrigatório.
sleekflow_remetente = "5551999998888"

# whatsappcloudapi | whatsapp360dialog | whatsapp (Twilio)
sleekflow_canal = "whatsappcloudapi"

# Só o 360dialog exige namespace de template.
# sleekflow_template_namespace = ""

# PRECISA bater exatamente com a condição de inscrição do fluxo de entrada.
sleekflow_etiqueta_em_curso = "agendamento-em-curso"

# A Platform API não atribui conversa a equipe; a entrega à Recepção é por
# etiqueta, que dispara um fluxo no Flow Builder.
sleekflow_etiqueta_recepcao = "transferir-recepcao"
# sleekflow_staff_id_recepcao = ""

# --- Banco -----------------------------------------------------------------
# Deixe comentado para o Terraform gerar a senha.
# postgres_password = ""

# Descomente para alcançar o banco por túnel SSH:
#   ssh -L 5432:127.0.0.1:5432 root@IP-DA-VPS
# postgres_porta_local = 5432

# --- Automação -------------------------------------------------------------
leitura_agenda_via_api    = true

# Módulo 2 desligado até a clínica confirmar que não duplica lembrete que já
# envia por outro meio. Ligar é trocar para true e dar apply.
confirmacao_ativa = false

# Devolve o menu a quem desistiu no meio do agendamento.
cron_expiracao_conversa = "0 0/10 * * * ?"
cron_sincronizacao_agenda = "0 0/15 * * * ?"
dias_sincronizacao_agenda = 2

# Qualquer outro parâmetro, no padrão Secao__Chave:
# env_extra = {
#   "Automacao__CronConfirmacao"   = "0 0 17 * * ?"
#   "Automacao__CronLembrete"      = "0 30 7 * * ?"
#   "Automacao__MaxHorariosOfertados" = "5"
# }
