              "host": [
                "{{api_gateway}}"
              ],
              "path": [
                "integracoes",
                "referencia",
                "{{identifier}}",
                "listar-profissionais"
              ],
              "query": [
                {
                  "key": "dataInicial",
                  "value": "2026-10-01"
                },
                {
                  "key": "dataFinal",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        },
        {
          "name": "Listar Agendamentos da Clínica (1 dia)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-authorization",
                "value": "{{token_agendamento}}"
              }
            ],
            "url": {
              "raw": "{{api_gateway}}/integracoes/referencia/{{identifier}}/{{usuclin}}/listar-agendamentos?data=2026-10-24&page=1",
              "host": [
                "{{api_gateway}}"
              ],
              "path": [
                "integracoes",
                "referencia",
                "{{identifier}}",
                "{{usuclin}}",
                "listar-agendamentos"
              ],
              "query": [
                {
                  "key": "data",
                  "value": "2026-10-24"
                },
                {
                  "key": "page",
                  "value": "1"
                }
