# Copie para .env e preencha. Nunca versione o .env.

POSTGRES_DB=ears
POSTGRES_USER=ears
POSTGRES_PASSWORD=troque-esta-senha

ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=ears;Username=ears;Password=troque-esta-senha

# Chave dos endpoints /admin
Admin__ApiKey=

# ---------------------------------------------------------------------------
# Amplimed
#
# Raiz do gateway, por ambiente. O caminho de cada API é montado pelo serviço.
#   dev  https://devintegracoes.amplimed.cloud/
#   qa   https://qaintegracoes.amplimed.cloud/
#   stg  https://stgintegracoes.amplimed.cloud/
#   prod https://integracoes.amplimed.com.br/
# ---------------------------------------------------------------------------

# API de Cadastro de Pacientes — cabeçalho x-Authorization: Basic {token}
Amplimed__Pacientes__BaseUrl=https://stgintegracoes.amplimed.cloud/
Amplimed__Pacientes__Token=

# API de Agendamento — identificador vai no caminho da rota; token no cabeçalho
Amplimed__Agendamento__BaseUrl=https://stgintegracoes.amplimed.cloud/
Amplimed__Agendamento__Identificador=
Amplimed__Agendamento__Token=

# Número da clínica (usuclin). Sem ele, listar-agendamentos e
# alterar-status-agendamento não funcionam — ou seja, o cenário A da Cláusula 3ª
# não roda e a confirmação cobre apenas o marcado pelo WhatsApp.
Amplimed__Agendamento__Usuclin=

# ---------------------------------------------------------------------------
# SleekFlow Platform API (https://api.sleekflow.io)
# A chave vai no cabeçalho X-Sleekflow-Api-Key, não como Bearer.
# ---------------------------------------------------------------------------
SleekFlow__ApiKey=
SleekFlow__WebhookSecret=

# whatsappcloudapi | whatsapp360dialog | whatsapp (Twilio)
SleekFlow__Canal=whatsappcloudapi

# Número remetente da clínica, com DDI e sem o "+". O endpoint de envio exige
# o campo "from"; sem ele nenhuma mensagem sai.
SleekFlow__RemetenteTelefone=

# Só o 360dialog exige namespace de template.
SleekFlow__TemplateNamespace=
SleekFlow__IdiomaTemplate=pt_BR

# PRECISA bater exatamente com a condição de inscrição do fluxo de entrada no
# Flow Builder ("a etiqueta NÃO contém este valor"). Divergir aqui faz o menu
# reabrir a cada resposta do paciente.
SleekFlow__EtiquetaAgendamentoEmCurso=agendamento-em-curso

# A Platform API não atribui conversa a uma equipe (o assignee só aceita
# staffId), então a entrega à Recepção é feita por etiqueta, que dispara um
# fluxo no Flow Builder.
SleekFlow__EtiquetaTransferirRecepcao=transferir-recepcao
SleekFlow__StaffIdRecepcao=

# Cláusula 3ª: true usa a agenda da Amplimed (cenário A, padrão desde a
# verificação da documentação). false degrada para o espelho local.
Automacao__LeituraAgendaViaApi=true

# A Amplimed não oferece webhook nesta integração: a agenda é conciliada por
# polling. Cron e janela em dias, contando hoje.
Automacao__CronSincronizacaoAgenda=0 0/15 * * * ?
Automacao__DiasSincronizacaoAgenda=2

# Módulo 2 (confirmação de véspera e lembrete). Desligado até a clínica
# confirmar que não duplica lembrete que ela já envia por outro meio.
Automacao__ConfirmacaoAtiva=false

# Expiração de conversa abandonada. É o que devolve o menu a quem desistiu no
# meio do agendamento, tirando a etiqueta agendamento-em-curso.
Automacao__CronExpiracaoConversa=0 0/10 * * * ?
