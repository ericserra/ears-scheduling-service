# Copie para .env e preencha. Nunca versione o .env.

POSTGRES_DB=ears
POSTGRES_USER=ears
POSTGRES_PASSWORD=troque-esta-senha

ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=ears;Username=ears;Password=troque-esta-senha

# Chave dos endpoints /admin
Admin__ApiKey=

# Amplimed — API de Cadastro de Pacientes (x-Authorization: Basic {token})
Amplimed__Pacientes__Token=

# Amplimed — API de Agendamento (Identificador + Token)
Amplimed__Agendamento__Identificador=
Amplimed__Agendamento__Token=

# Amplimed — API de Dados (client_id/secret -> Bearer)
Amplimed__Dados__ClientId=
Amplimed__Dados__ClientSecret=

# SleekFlow
SleekFlow__ApiKey=
SleekFlow__WebhookSecret=

# Cláusula 3ª: alternar para true após confirmar a leitura de agenda pela API
Automacao__LeituraAgendaViaApi=false
